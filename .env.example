# Copy to .env and fill in real values before running docker-compose
# NEVER commit .env to version control

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_strong_password

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change_me_redis_password

# ── API ───────────────────────────────────────────────────────────────────
NODE_ENV=production
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_xxxxxx
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_xxxxx
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=https://qcart.qa,https://www.qcart.qa

# ── Rate limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── Tuning ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
DB_POOL_MIN=2
DB_POOL_MAX=10
RESET_TOKEN_EXPIRY_MS=3600000
