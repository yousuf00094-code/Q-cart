# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── PostgreSQL ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://qcart:secret@localhost:5432/qcart
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Rate Limiting ─────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ── Bcrypt ────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── Password Reset ────────────────────────────────────────────────────────
RESET_TOKEN_EXPIRY_MS=3600000

# ── Pagination ────────────────────────────────────────────────────────────
DEFAULT_PAGE_LIMIT=24
MAX_PAGE_LIMIT=100

# ── Loyalty ───────────────────────────────────────────────────────────────
LOYALTY_POINTS_PER_QAR=1
LOYALTY_REDEEM_RATE=0.01
